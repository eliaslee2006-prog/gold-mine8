:root{
  --bg:#09090d;--panel:#111217;--panel2:#171820;--line:#292a33;--line-soft:#20212a;
  --text:#f0eef5;--muted:#8f8d99;--faint:#64636d;--cyan:#00d9ff;--mag:#ff3ea5;
  --red:#ff405c;--amber:#ffba4a;--green:#6ee7a7;--violet:#8b6cff;
  --radius:15px;--shadow:0 18px 70px rgba(0,0,0,.30);
  --body-font:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --editorial:"Times New Roman",Times,serif;
  --telemetry:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --calendar-time-font:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  --hour-height:64px;--event-opacity:.82;--event-radius:8px;--axis-width:62px;
}
*{box-sizing:border-box}html{background:var(--bg);color-scheme:dark}body{margin:0;background:radial-gradient(circle at 86% -12%,rgba(139,67,255,.085),transparent 34%),var(--bg);color:var(--text);font-family:var(--body-font);min-height:100vh}
button,input,select,textarea{font:inherit}.hidden{display:none!important}button{cursor:pointer}
.boot-cover{position:fixed;inset:0;z-index:999;background:#09090d;display:grid;place-items:center;font:12px var(--telemetry);letter-spacing:.2em;color:var(--cyan);transition:.25s opacity}.boot-cover.off{opacity:0;pointer-events:none}
.topbar{min-height:88px;display:flex;justify-content:space-between;gap:24px;align-items:flex-end;padding:20px clamp(16px,3vw,42px) 15px;border-bottom:1px solid var(--line);background:rgba(9,9,13,.82);backdrop-filter:blur(14px);position:sticky;top:0;z-index:30}
.eyebrow,.kicker{font:10px var(--telemetry);letter-spacing:.18em;color:var(--muted)}h1,h2{font-family:var(--editorial);font-weight:400;margin:0}h1{font-size:clamp(25px,3vw,39px);letter-spacing:.01em}h2{font-size:24px}
.top-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.pill,.telemetry{border:1px solid var(--line);padding:7px 9px;border-radius:999px;font:10px var(--telemetry);letter-spacing:.08em}.telemetry{border-color:transparent;color:var(--muted)}
.tabs{display:flex;gap:4px;padding:9px clamp(16px,3vw,42px);border-bottom:1px solid var(--line);overflow:auto}.tab{background:transparent;color:var(--muted);border:0;padding:9px 14px;font:11px var(--telemetry);letter-spacing:.1em;border-bottom:2px solid transparent}.tab.active{color:var(--text);border-color:var(--mag)}.tab:disabled{opacity:.35}
.ops-grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:14px;padding:14px clamp(12px,2vw,28px) 28px;max-width:1900px;margin:auto}.right-rail{display:grid;gap:14px;align-content:start}
.panel{background:linear-gradient(180deg,rgba(23,24,32,.86),rgba(17,18,23,.94));border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 18px;border-bottom:1px solid var(--line)}.panel-head.compact{padding:14px}.panel-head .kicker{display:block;margin-bottom:4px}.actions{display:flex;gap:8px;flex-wrap:wrap}
.primary,.ghost,.danger,.filter,.hud-icon,.calendar-view{min-height:38px;border-radius:9px;padding:0 12px;border:1px solid var(--line);font:11px var(--telemetry);letter-spacing:.08em}.primary{background:rgba(0,217,255,.09);border-color:rgba(0,217,255,.35);color:var(--cyan)}.ghost{background:#15161b;color:var(--text)}.danger{background:rgba(255,64,92,.1);border-color:rgba(255,64,92,.35);color:var(--red)}.small{min-height:34px;padding:0 9px}
.calendar-panel{min-width:0}.calendar-commandbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border-bottom:1px solid var(--line-soft);background:rgba(8,9,13,.48)}.calendar-nav{display:flex;align-items:center;gap:7px;min-width:0}.hud-icon{width:38px;padding:0;background:#101116;color:#dcd9e4}.calendar-period{display:grid;gap:2px;margin-left:7px;min-width:0}.calendar-period strong{font-family:var(--editorial);font-weight:400;font-size:17px;white-space:nowrap}.calendar-view-switch{display:flex;border:1px solid var(--line);border-radius:10px;padding:3px;background:#0d0e12}.calendar-view{min-height:31px;border:0;background:transparent;color:var(--muted);padding:0 10px}.calendar-view.active{background:#191a20;color:#fff;box-shadow:inset 0 -1px 0 var(--mag)}
.scheduler{min-height:690px;background:#0b0c10}.scheduler-scroll{height:min(72vh,860px);min-height:620px;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable;background:#0b0c10;position:relative}.scheduler-scroll::-webkit-scrollbar{width:10px;height:10px}.scheduler-scroll::-webkit-scrollbar-track{background:#090a0e}.scheduler-scroll::-webkit-scrollbar-thumb{background:#2a2c36;border:2px solid #090a0e;border-radius:99px}
.scheduler-header{display:grid;position:sticky;top:0;z-index:18;min-width:max-content;background:rgba(12,13,18,.96);backdrop-filter:blur(10px);border-bottom:1px solid #30313a}.scheduler-header .axis-head{position:sticky;left:0;z-index:22;background:#0c0d12}.day-header{height:54px;padding:9px 10px;display:flex;align-items:flex-end;justify-content:space-between;gap:8px;border-right:1px solid #252630;color:#a7a5b0}.day-header.today{color:var(--cyan);background:linear-gradient(180deg,rgba(0,217,255,.055),transparent)}.day-name{font:11px var(--telemetry);letter-spacing:.08em}.day-number{font:24px var(--editorial);line-height:.9}.axis-head{width:var(--axis-width);height:54px;border-right:1px solid #30313a;display:grid;place-items:end center;padding-bottom:9px;font:9px var(--telemetry);letter-spacing:.12em;color:var(--faint)}
.scheduler-body{display:grid;position:relative;min-width:max-content}.time-axis{position:sticky;left:0;z-index:12;width:var(--axis-width);background:#0c0d12;border-right:1px solid #30313a;box-shadow:8px 0 16px rgba(0,0,0,.10)}.time-label{position:absolute;right:8px;transform:translateY(-50%);font-family:var(--calendar-time-font);font-size:11px;font-weight:500;font-variant-numeric:tabular-nums;color:#858590;white-space:nowrap;line-height:1}.time-label.minor{font-size:9px;color:#4f5059}
.day-lane{position:relative;border-right:1px solid #252630;background-color:#0d0e13;background-image:linear-gradient(to bottom,rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.018) 1px,transparent 1px);background-size:100% var(--hour-height),100% calc(var(--hour-height)/2);touch-action:pan-y pinch-zoom}.day-lane.today{background-color:#0d1116}.day-lane::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(0,217,255,.016),transparent 45%)}
.event-block{--event-color:#00d9ff;position:absolute;z-index:5;min-height:22px;border:1px solid color-mix(in srgb,var(--event-color) 48%,transparent);border-left:4px solid var(--event-color);border-radius:var(--event-radius);background:color-mix(in srgb,var(--event-color) calc(var(--event-opacity)*100%),#11141a);box-shadow:0 8px 25px rgba(0,0,0,.27),inset 0 0 0 1px rgba(255,255,255,.04);color:#fff;overflow:hidden;touch-action:none;user-select:none;transition:filter .13s,box-shadow .13s,transform .13s}.event-block:hover{filter:brightness(1.08);box-shadow:0 10px 30px rgba(0,0,0,.34),0 0 0 1px color-mix(in srgb,var(--event-color) 30%,transparent)}.event-block.dragging{opacity:.78;z-index:40;box-shadow:0 18px 50px rgba(0,0,0,.58),0 0 0 1px var(--event-color)}.event-content{height:100%;padding:6px 7px 8px;display:flex;flex-direction:column;gap:2px;overflow:hidden}.event-time{font-family:var(--calendar-time-font);font-size:9px;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:.025em;color:rgba(255,255,255,.76);white-space:nowrap}.event-title{font-size:12px;font-weight:650;line-height:1.17;white-space:normal;overflow:hidden;text-shadow:0 1px 6px rgba(0,0,0,.25)}.event-type{margin-top:auto;font:8px var(--telemetry);letter-spacing:.10em;color:rgba(255,255,255,.60);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.event-resize{position:absolute;left:0;right:0;bottom:0;height:10px;cursor:ns-resize}.event-resize::after{content:"";position:absolute;left:38%;right:38%;bottom:2px;height:2px;border-radius:5px;background:rgba(255,255,255,.35)}
.now-line{position:absolute;height:1px;background:var(--mag);left:0;right:0;z-index:9;box-shadow:0 0 8px rgba(255,62,165,.55);pointer-events:none}.now-dot{position:absolute;width:7px;height:7px;border-radius:50%;background:var(--mag);left:-3px;top:-3px;box-shadow:0 0 9px rgba(255,62,165,.75)}
.all-day-strip{display:grid;min-width:max-content;background:#0c0d12;border-bottom:1px solid #30313a}.all-day-axis{position:sticky;left:0;z-index:14;width:var(--axis-width);padding:8px 5px;background:#0c0d12;border-right:1px solid #30313a;text-align:right;font:8px var(--telemetry);letter-spacing:.08em;color:var(--faint)}.all-day-cell{min-height:34px;padding:4px;border-right:1px solid #252630;display:flex;gap:4px;flex-wrap:wrap;align-items:flex-start}.all-day-event{border-radius:6px;padding:4px 6px;font-size:10px;border-left:3px solid var(--event-color);background:color-mix(in srgb,var(--event-color) 20%,#11141a);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.month-grid{display:grid;grid-template-columns:repeat(7,minmax(120px,1fr));min-width:840px;border-top:1px solid #272832}.month-head{padding:10px;border-right:1px solid #272832;border-bottom:1px solid #272832;color:#8f8e99;font:10px var(--telemetry);letter-spacing:.08em}.month-cell{min-height:130px;padding:8px;border-right:1px solid #272832;border-bottom:1px solid #272832;background:#0d0e13}.month-cell.outside{opacity:.38}.month-cell.today{box-shadow:inset 0 0 0 1px rgba(0,217,255,.24)}.month-date{font-family:var(--editorial);font-size:20px;margin-bottom:7px}.month-event{--event-color:#00d9ff;display:block;width:100%;border:0;border-left:3px solid var(--event-color);background:color-mix(in srgb,var(--event-color) 16%,#11141a);color:#eee;text-align:left;border-radius:5px;padding:5px 6px;margin:3px 0;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.agenda{padding:12px}.agenda-day{border-top:1px solid #262730;padding:12px 0}.agenda-day:first-child{border-top:0}.agenda-date{display:flex;align-items:baseline;gap:8px;margin-bottom:8px}.agenda-date strong{font-family:var(--editorial);font-size:21px;font-weight:400}.agenda-date span{font:9px var(--telemetry);letter-spacing:.1em;color:var(--muted)}.agenda-event{--event-color:#00d9ff;display:grid;grid-template-columns:82px 4px 1fr auto;gap:10px;align-items:center;padding:9px 8px;border-radius:8px;background:rgba(255,255,255,.018);margin:4px 0;cursor:pointer}.agenda-event:hover{background:rgba(255,255,255,.032)}.agenda-time{font-family:var(--calendar-time-font);font-size:11px;font-weight:600;font-variant-numeric:tabular-nums;color:#9d9ca6}.agenda-bar{height:28px;border-radius:99px;background:var(--event-color)}.agenda-title{font-size:12px}.agenda-type{font:8px var(--telemetry);letter-spacing:.1em;color:var(--muted)}
.nexus-core{display:flex;align-items:center;gap:14px;padding:18px}.avatar-placeholder{width:78px;height:78px;border-radius:18px;display:grid;place-items:center;background:radial-gradient(circle,rgba(255,62,165,.2),rgba(0,217,255,.06));border:1px solid rgba(255,62,165,.3);font:22px var(--telemetry);color:var(--mag)}.nexus-core p{color:var(--muted);font-size:12px;margin:6px 0}.mood{font:10px var(--telemetry);color:var(--cyan);border:1px solid rgba(0,217,255,.3);padding:6px 8px;border-radius:999px}
.task-filters{display:flex;padding:10px 12px;gap:6px}.filter{min-height:30px;background:transparent;color:var(--muted);padding:0 8px}.filter.active{color:var(--text);border-color:#555765}.task-list{padding:0 12px 12px;display:grid;gap:8px;max-height:500px;overflow:auto}.task{border:1px solid var(--line);background:#101116;border-radius:10px;padding:10px;display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:start}.task.done{opacity:.55}.task-check{appearance:none;width:18px;height:18px;border:1px solid #555765;border-radius:5px;margin:2px 0;cursor:pointer}.task-check:checked{background:var(--green);border-color:var(--green);box-shadow:inset 0 0 0 4px #111217}.task-title{font-size:13px}.task-meta{margin-top:5px;display:flex;gap:6px;flex-wrap:wrap;color:var(--muted);font:9px var(--telemetry);letter-spacing:.05em}.task-open{border:0;background:transparent;color:var(--muted);font-size:18px}
.status-grid{padding:15px;display:grid;grid-template-columns:1fr auto;gap:9px;font:10px var(--telemetry);color:var(--muted)}.status-grid b{color:var(--text);font-weight:500}.brief-card>.kicker{display:block;padding:14px 15px 0}
.modal{width:min(660px,calc(100vw - 24px));border:1px solid #393a44;border-radius:16px;background:#111217;color:var(--text);padding:0;box-shadow:0 40px 120px rgba(0,0,0,.65)}.modal.narrow{width:min(460px,calc(100vw - 24px))}.modal::backdrop{background:rgba(0,0,0,.68);backdrop-filter:blur(3px)}.modal form{padding:16px}.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.modal .x{border:0;background:transparent;color:var(--muted);font-size:26px}.modal label{display:grid;gap:6px;margin:10px 0;color:var(--muted);font:10px var(--telemetry);letter-spacing:.07em;text-transform:uppercase}.modal input,.modal select,.modal textarea{width:100%;background:#0d0e13;border:1px solid #30313a;border-radius:9px;color:var(--text);padding:10px;outline:none}.modal input:focus,.modal select:focus,.modal textarea:focus{border-color:rgba(0,217,255,.5);box-shadow:0 0 0 2px rgba(0,217,255,.07)}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.modal-actions{display:grid;grid-template-columns:auto 1fr auto auto;gap:8px;margin-top:14px}.color-control{display:flex;align-items:center;gap:8px}.color-control>input{width:54px;height:41px;padding:4px}.color-presets{display:flex;gap:5px;flex-wrap:wrap}.color-presets button{width:24px;height:24px;border-radius:50%;background:var(--swatch);border:2px solid #111217;box-shadow:0 0 0 1px #3a3b44}
.repeat-box{border:1px solid #2b2c35;border-radius:11px;padding:10px 11px;margin-top:12px}.repeat-box legend{padding:0 6px;font:10px var(--telemetry);letter-spacing:.1em;color:#a09eaa;text-transform:uppercase}.repeat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.inline-field{display:grid;grid-template-columns:70px 1fr;gap:6px}.repeat-days{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}.repeat-days button{width:35px;height:35px;border-radius:8px;border:1px solid #373842;background:#0d0e13;color:#8e8d98;font:10px var(--telemetry)}.repeat-days button.active{border-color:rgba(0,217,255,.55);background:rgba(0,217,255,.09);color:var(--cyan)}.repeat-ends{display:grid;grid-template-columns:1fr 1fr;gap:10px}.repeat-summary{margin-top:9px;padding:8px 9px;border-left:2px solid var(--cyan);background:rgba(0,217,255,.035);font:9px var(--telemetry);letter-spacing:.06em;color:#aaa9b3}
.field-value{float:right;color:var(--cyan)}input[type=range]{padding:0!important;accent-color:var(--cyan)}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,18px);z-index:120;background:#111217;border:1px solid #373943;border-radius:10px;padding:10px 13px;opacity:0;pointer-events:none;transition:.18s;color:#eee;font:10px var(--telemetry);letter-spacing:.06em;box-shadow:0 15px 50px rgba(0,0,0,.45)}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:1100px){.ops-grid{grid-template-columns:1fr}.right-rail{grid-template-columns:1fr 1fr}.brief-card{grid-column:1/-1}}
@media(max-width:700px){
  .topbar{align-items:flex-start;flex-direction:column}.top-meta{justify-content:flex-start}.ops-grid{padding:10px}.right-rail{grid-template-columns:1fr}
  .panel-head{padding:13px}.calendar-panel-head{display:block}.calendar-panel-head .actions{display:grid;grid-template-columns:1fr 1fr;margin-top:11px}
  .calendar-commandbar{align-items:stretch;flex-direction:column;padding:9px}.calendar-nav{width:100%}.calendar-period{flex:1}.calendar-period strong{font-size:15px}
  .calendar-view-switch{display:grid;grid-template-columns:repeat(4,1fr);width:100%}.calendar-view{padding:0 4px;font-size:9px}
  :root{--axis-width:56px}.scheduler-scroll{height:70vh;min-height:560px}.day-header{height:48px;padding:7px}.day-number{font-size:20px}.day-name{font-size:9px}
  .time-label{right:6px;font-size:10px}.event-title{font-size:11px}.event-time{font-size:8px}.event-type{font-size:7px}
  .two,.repeat-grid,.repeat-ends{grid-template-columns:1fr}.modal-actions{grid-template-columns:1fr 1fr}.modal-actions span{display:none}.modal-actions .danger{grid-column:1/-1}
}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
