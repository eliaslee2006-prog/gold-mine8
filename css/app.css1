/* NEON OPERATIONS CENTER // PHASE 9A
   Additive styles only. Existing V9 appearance variables remain authoritative. */

:root{
  --p9-panel-bg:color-mix(in srgb,var(--panel,#111217) 92%,transparent);
  --p9-soft:color-mix(in srgb,var(--accent-primary,#00d9ff) 10%,transparent);
}

/* Calendar: true whole-day editor + bounded month cells */
.phase9a-temporal{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;margin:2px 0 10px;border:1px solid var(--line-soft,var(--line));border-radius:calc(var(--radius,12px) * .7);background:var(--p9-soft)}
.phase9a-temporal>span{font:600 calc(10px * var(--telemetry-scale,1))/1.2 var(--telemetry,ui-monospace,monospace);letter-spacing:.08em;color:var(--muted,#8b8d98);text-align:right}
.phase9a-check{display:flex!important;align-items:center;gap:8px!important;min-height:32px;font:700 calc(11px * var(--telemetry-scale,1))/1.2 var(--telemetry,ui-monospace,monospace)!important;letter-spacing:.08em}
.phase9a-check input{width:18px;height:18px;accent-color:var(--accent-primary,#00d9ff)}
.phase9a-avatar-attach{border:1px solid var(--line-soft,var(--line));border-radius:calc(var(--radius,12px) * .7);padding:12px;margin:12px 0;background:color-mix(in srgb,var(--panel2,#171820) 84%,transparent)}
.phase9a-avatar-attach legend{padding:0 7px;font:700 calc(10px * var(--telemetry-scale,1))/1 var(--telemetry,ui-monospace,monospace);letter-spacing:.09em;color:var(--accent-selected,#ff3ea5)}
.phase9a-avatar-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,1.2fr) auto;gap:8px;align-items:center}
.phase9a-avatar-attach small{display:block;margin-top:8px;color:var(--muted,#8b8d98);font-size:11px}
.phase9a-file-button{display:flex!important;align-items:center;justify-content:center;min-height:38px;border:1px solid var(--line,var(--line-soft));border-radius:8px;background:var(--panel2,#171820);font:700 10px/1 var(--telemetry,ui-monospace,monospace)!important;letter-spacing:.08em;cursor:pointer}
.phase9a-file-button input{display:none}
#eventAvatarStatus{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted,#8b8d98);font:600 10px/1.25 var(--telemetry,ui-monospace,monospace)}

.month-cell{position:relative;overflow:hidden;min-height:118px;max-height:148px;display:flex;flex-direction:column}
.phase9a-month-events{display:grid;gap:3px;min-height:0;overflow:hidden;flex:1;align-content:start}
.phase9a-month-event{min-height:20px;max-height:24px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.phase9a-month-pager{display:grid;grid-template-columns:26px 1fr 26px;align-items:center;gap:4px;height:26px;margin-top:auto;border-top:1px solid var(--line-soft,var(--line));background:color-mix(in srgb,var(--panel,#111217) 94%,transparent)}
.phase9a-month-pager button{height:24px;min-width:24px;border:0;background:transparent;color:var(--accent-primary,#00d9ff);font-size:18px}
.phase9a-month-pager span{text-align:center;font:700 9px/1 var(--telemetry,ui-monospace,monospace);letter-spacing:.08em;color:var(--muted,#8b8d98)}

/* Allowance Futures */
.allowance-futures-panel{grid-column:1/-1}
.futures-metrics{grid-template-columns:repeat(5,minmax(0,1fr))}
.futures-metrics b[data-band="bad"]{color:var(--accent-danger,#ff405c)}
.futures-metrics b[data-band="watch"]{color:var(--accent-warning,#ffba4a)}
.futures-metrics b[data-band="good"]{color:var(--accent-success,#6ee7a7)}
.futures-intel{margin:12px var(--panel-padding-effective,16px) 0;padding:13px 14px;border:1px solid var(--line-soft,var(--line));border-left:3px solid var(--accent-selected,#ff3ea5);border-radius:10px;background:color-mix(in srgb,var(--accent-selected,#ff3ea5) 5%,var(--panel2,#171820))}
.futures-intel p{margin:5px 0 0;max-width:1100px;color:var(--text,#ececf2);font-size:13px;line-height:1.45}
.futures-curve-shell{height:190px;margin:12px var(--panel-padding-effective,16px);border:1px solid var(--line-soft,var(--line));border-radius:10px;overflow:hidden;background:linear-gradient(180deg,color-mix(in srgb,var(--accent-primary,#00d9ff) 4%,transparent),transparent 60%),var(--panel2,#171820)}
#futureCurve{width:100%;height:100%;overflow:visible}
.futures-zero{stroke:color-mix(in srgb,var(--accent-danger,#ff405c) 55%,transparent);stroke-width:1;stroke-dasharray:8 8}
.futures-line{fill:none;stroke:var(--accent-primary,#00d9ff);stroke-width:4;vector-effect:non-scaling-stroke;filter:drop-shadow(0 0 8px color-mix(in srgb,var(--accent-primary,#00d9ff) 35%,transparent))}
.futures-dot{fill:var(--panel,#111217);stroke:var(--accent-selected,#ff3ea5);stroke-width:3;vector-effect:non-scaling-stroke}
.future-record{width:100%;display:grid;grid-template-columns:minmax(0,1.8fr) minmax(130px,.8fr) minmax(130px,.8fr);gap:12px;align-items:center;padding:11px 12px;border:0;border-bottom:1px solid var(--line-soft,var(--line));background:transparent;color:inherit;text-align:left}
.future-record:hover,.future-record:focus-visible{background:color-mix(in srgb,var(--accent-primary,#00d9ff) 6%,transparent)}
.future-record span{display:grid;gap:3px;min-width:0}.future-record b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.future-record small{color:var(--muted,#8b8d98);font:600 9px/1.2 var(--telemetry,ui-monospace,monospace);letter-spacing:.06em}.future-record>span:nth-child(n+2){text-align:right}.future-empty{padding:20px;color:var(--muted,#8b8d98);text-align:center;font:600 10px/1.4 var(--telemetry,ui-monospace,monospace);letter-spacing:.08em}

/* NEXUS speech + event avatar */
.nexus-card{position:relative;overflow:visible}
.phase9a-speech-bubble{--p9-bubble-width:300px;--p9-bubble-opacity:.92;--p9-bubble-scale:1;position:absolute;z-index:18;width:min(var(--p9-bubble-width),calc(100vw - 32px));padding:10px 12px;border:1px solid color-mix(in srgb,var(--accent-selected,#ff3ea5) 58%,var(--line));border-radius:12px;background:color-mix(in srgb,var(--panel,#111217) calc(var(--p9-bubble-opacity) * 100%),transparent);box-shadow:0 14px 38px rgba(0,0,0,.28);transform:scale(var(--p9-bubble-scale));transform-origin:bottom left;backdrop-filter:blur(12px)}
.phase9a-speech-bubble[data-position="right"]{left:calc(100% + 10px);top:52px}.phase9a-speech-bubble[data-position="left"]{right:calc(100% + 10px);top:52px;transform-origin:bottom right}.phase9a-speech-bubble[data-position="above"]{left:10px;bottom:calc(100% + 10px)}
.phase9a-speech-bubble span{font:700 9px/1 var(--telemetry,ui-monospace,monospace);letter-spacing:.1em;color:var(--accent-selected,#ff3ea5)}
.phase9a-speech-bubble p{margin:6px 0 0;font-size:12px;line-height:1.4;color:var(--text,#ececf2)}
.phase9a-avatar-media{position:absolute;inset:0;z-index:9;overflow:hidden;border-radius:inherit;background:var(--panel,#111217)}
.phase9a-avatar-override{width:100%;height:100%;display:block;object-fit:cover}
.phase9a-avatar-pager{position:absolute;z-index:12;left:50%;bottom:6px;transform:translateX(-50%);display:grid;grid-template-columns:28px auto 28px;align-items:center;gap:3px;padding:3px;border:1px solid var(--line-soft,var(--line));border-radius:999px;background:rgba(9,9,13,.82);backdrop-filter:blur(8px)}
.phase9a-avatar-pager button{width:28px;height:28px;border:0;border-radius:999px;background:transparent;color:var(--accent-primary,#00d9ff);font-size:18px}.phase9a-avatar-pager span{min-width:38px;text-align:center;font:700 8px/1 var(--telemetry,ui-monospace,monospace);letter-spacing:.07em}
.phase9a-settings-panel{margin-top:var(--panel-gap-effective,14px)}
.phase9a-settings-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:var(--panel-padding-effective,16px)}
.phase9a-settings-grid label{display:grid;gap:7px}.phase9a-settings-grid label>span{justify-self:end;color:var(--muted,#8b8d98);font:700 9px/1 var(--telemetry,ui-monospace,monospace)}
.phase9a-settings-grid .modal-actions{grid-column:1/-1}

/* Provider / broker / intelligence adapters */
.phase9a-provider-bar{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:8px 12px;padding:8px 12px;border-top:1px solid var(--line-soft,var(--line));border-bottom:1px solid var(--line-soft,var(--line));background:color-mix(in srgb,var(--panel2,#171820) 78%,transparent)}
.phase9a-provider-bar>span{font:700 9px/1 var(--telemetry,ui-monospace,monospace);letter-spacing:.09em;color:var(--muted,#8b8d98)}.phase9a-provider-bar>div{display:flex;gap:5px;flex-wrap:wrap}.phase9a-provider-bar button{min-height:30px;padding:0 9px;border:1px solid var(--line-soft,var(--line));border-radius:7px;background:transparent;color:var(--muted,#8b8d98);font:700 9px/1 var(--telemetry,ui-monospace,monospace);letter-spacing:.06em}.phase9a-provider-bar button.active{border-color:var(--accent-selected,#ff3ea5);color:var(--accent-selected,#ff3ea5);background:color-mix(in srgb,var(--accent-selected,#ff3ea5) 9%,transparent)}.phase9a-provider-bar button:disabled{opacity:.36}.phase9a-provider-bar small{grid-column:2;color:var(--muted,#8b8d98);font-size:9px}
.phase9a-broker-panel{grid-column:1/-1}.phase9a-intel-panel{margin-bottom:var(--panel-gap-effective,14px)}
.phase9a-adapter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:var(--panel-padding-effective,16px)}.phase9a-adapter-grid>div{display:grid;grid-template-columns:1fr auto;gap:5px 10px;padding:12px;border:1px solid var(--line-soft,var(--line));border-radius:10px;background:var(--panel2,#171820)}.phase9a-adapter-grid span{font:700 10px/1 var(--telemetry,ui-monospace,monospace);letter-spacing:.07em}.phase9a-adapter-grid b{font:700 9px/1 var(--telemetry,ui-monospace,monospace);color:var(--muted,#8b8d98)}.phase9a-adapter-grid b[data-state="live"]{color:var(--accent-success,#6ee7a7)}.phase9a-adapter-grid b[data-state="offline"]{color:var(--accent-warning,#ffba4a)}.phase9a-adapter-grid small{grid-column:1/-1;color:var(--muted,#8b8d98);font-size:10px}.phase9a-broker-positions{padding:0 var(--panel-padding-effective,16px) var(--panel-padding-effective,16px)}.phase9a-broker-summary{display:flex;justify-content:space-between;gap:10px;padding:9px 10px;border-top:1px solid var(--line-soft,var(--line));font:600 9px/1.2 var(--telemetry,ui-monospace,monospace);color:var(--muted,#8b8d98)}

@media (max-width:1100px){.phase9a-speech-bubble[data-position="right"],.phase9a-speech-bubble[data-position="left"]{left:10px;right:auto;top:auto;bottom:calc(100% + 8px);transform-origin:bottom left}.futures-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.phase9a-settings-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:720px){.phase9a-temporal{align-items:flex-start;flex-direction:column}.phase9a-temporal>span{text-align:left}.phase9a-avatar-row{grid-template-columns:1fr}.month-cell{min-height:104px;max-height:124px}.phase9a-month-events{gap:2px}.phase9a-month-event{min-height:19px;max-height:21px;font-size:9px}.futures-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.futures-curve-shell{height:150px;margin-left:var(--panel-padding-mobile,10px);margin-right:var(--panel-padding-mobile,10px)}.future-record{grid-template-columns:minmax(0,1fr) auto}.future-record>span:nth-child(3){grid-column:1/-1;display:flex;justify-content:space-between;text-align:left}.phase9a-settings-grid{grid-template-columns:1fr;padding:var(--panel-padding-mobile,10px)}.phase9a-adapter-grid{grid-template-columns:1fr;padding:var(--panel-padding-mobile,10px)}.phase9a-provider-bar{grid-template-columns:1fr}.phase9a-provider-bar small{grid-column:1}.phase9a-provider-bar button{min-height:36px}.phase9a-speech-bubble{position:relative!important;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;width:auto;margin:8px 10px 10px;transform:none!important}.phase9a-broker-summary{flex-direction:column}.phase9a-file-button,#eventAvatarRemove{min-height:44px}}
@media (prefers-reduced-motion:reduce){.phase9a-speech-bubble,.phase9a-avatar-media,.phase9a-avatar-override{transition:none!important;animation:none!important}}
